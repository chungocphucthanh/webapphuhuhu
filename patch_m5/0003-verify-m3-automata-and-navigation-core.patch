+    assert daily[0]["R1_state"] == "run1" and daily[1]["R1_state"] == "run0"
+    with pytest.raises(ValueError, match="Unknown staff_id"):
+        staff_daily_trace_rows(custom, [(0, 0), (1, 1)], "MISSING")
