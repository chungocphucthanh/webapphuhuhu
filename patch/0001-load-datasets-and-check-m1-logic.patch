+"""Module 1 dashboard section: CNF satisfiability, minimal UNSAT core, and ILP bridge."""
+from __future__ import annotations
+from dataclasses import dataclass
+import pandas as pd
+from pysat.solvers import Solver
+import streamlit as st
+from app.data_context import DatasetContext
+from m1_logic.cnf import encode_invigilator_assignment
+from m1_logic.linear_bridge import CONVERSION_ROWS, encode_invigilator_assignment_linear
+from m1_logic.unsat_core import encode_with_selectors, extract_minimal_core
+
+_RULE_FAMILIES = {"H1 Availability": "busy", "H2 No double-booking": "overlap", "H3 Exact capacity": "capacity"}
+
+@dataclass(frozen=True)
+class M1CheckResult:
+    satisfiable: bool
+    num_vars: int
+    num_clauses: int
+    sample_assignments: tuple[dict[str, object], ...]
+    unsat_core: tuple[str, ...]
+    summary_rows: tuple[dict[str, str], ...]
+
+def build_logic_ilp_table(ctx: DatasetContext | None = None, *, counts: dict[str, int] | None = None) -> tuple[dict[str, str], ...]:
+    """Return Logic-to-0/1-ILP conversion rows with active row counts when ctx is supplied."""
+    if counts is None and ctx is not None:
+        inst = ctx.instance
+        n, m = len(inst.staff_ids), len(inst.session_names)
+        counts = encode_invigilator_assignment_linear(n, inst.demand, [(i, j) for i in range(n) for j in range(m) if (i, j) not in inst.A], inst.overlaps).summary()
+    return tuple({"rule": r, "fol": fol, "clause": cl, "cnf": cnf, "linear_ilp": lin,
+                  "active_rows": str(counts.get(_RULE_FAMILIES[r], 0)) if (counts is not None and r in _RULE_FAMILIES) else "-"} for r, fol, cl, cnf, lin in CONVERSION_ROWS)
+
+@st.cache_data(show_spinner=False)
+def _solve_m1_cached(staff_ids: tuple[str, ...], session_names: tuple[str, ...], demands: tuple[int, ...],
+                     busy: tuple[tuple[int, int], ...], overlaps: tuple[tuple[int, int], ...]) -> M1CheckResult:
+    n, m = len(staff_ids), len(session_names)
+    cnf = encode_invigilator_assignment(n, list(demands), list(busy), list(overlaps))
+    with Solver(name="m22", bootstrap_with=cnf.clauses) as solver:
+        satisfiable, literals = bool(solver.solve()), (solver.get_model() or [])
+    counts = encode_invigilator_assignment_linear(n, list(demands), list(busy), list(overlaps)).summary()
+    if satisfiable:
+        by_s = [[staff_ids[(lit - 1) // m] for lit in sorted(literals) if 0 < lit <= n * m and (lit - 1) % m == j] for j in range(min(m, 12))]
+        sample, core = tuple({"session_id": session_names[j], "demand": demands[j], "assigned_staff": ", ".join(by_s[j])} for j in range(len(by_s))), ()
+    else:
+        guarded, selectors = encode_with_selectors(n, list(demands), list(busy), list(overlaps), staff_ids=list(staff_ids), session_labels=list(session_names))
+        raw_core = extract_minimal_core(guarded, selectors)
+        if raw_core is None:
+            raise RuntimeError("Selector CNF disagrees with plain CNF")
+        sample, core = (), tuple(selectors[s] for s in sorted(raw_core))
+    return M1CheckResult(satisfiable, cnf.nv, len(cnf.clauses), sample, core, build_logic_ilp_table(counts=counts))
+
+def check_m1_feasibility(ctx: DatasetContext, *, force_unsat: bool = False, extra_busy: tuple[tuple[int, int], ...] = ()) -> M1CheckResult:
+    """Run cached CNF SAT check and minimal UNSAT core extraction on DatasetContext."""
+    if not isinstance(ctx, DatasetContext) or type(force_unsat) is not bool:
+        raise ValueError("Expected DatasetContext and boolean force_unsat")
+    inst = ctx.instance
+    n, m = len(inst.staff_ids), len(inst.session_names)
+    busy_set = {(i, j) for i in range(n) for j in range(m) if (i, j) not in inst.A}
+    for pair in extra_busy:
+        if not isinstance(pair, (tuple, list)) or len(pair) != 2 or type(pair[0]) is not int or type(pair[1]) is not int or not (0 <= pair[0] < n and 0 <= pair[1] < m):
+            raise ValueError(f"extra_busy pair outside instance bounds: {pair!r}")
+        busy_set.add((pair[0], pair[1]))
+    if force_unsat and m > 0:
+        avail = [i for i in range(n) if (i, 0) not in busy_set]
+        busy_set.update((i, 0) for i in avail[max(0, inst.demand[0] - 1):])
+    return _solve_m1_cached(tuple(inst.staff_ids), tuple(inst.session_names), tuple(inst.demand), tuple(sorted(busy_set)), tuple(inst.overlaps))
+
+def render_m1_section(ctx: DatasetContext, *, force_unsat: bool = False) -> M1CheckResult:
+    """Render M1 feasibility status, witness/UNSAT core, and Logic-to-ILP bridge table."""
+    st.subheader("M1. Propositional Logic, CNF Satisfiability & 0/1 ILP Bridge")
+    result = check_m1_feasibility(ctx, force_unsat=force_unsat or st.checkbox("Simulate single-session staff shortage (UNSAT core)", value=False, key="m1_force_unsat"))
+    for col, (lbl, val) in zip(st.columns(4), (("CNF Status", "SAT" if result.satisfiable else "UNSAT"), ("CNF Variables", f"{result.num_vars:,}"),
+                                               ("CNF Clauses", f"{result.num_clauses:,}"), ("Assignment Vars (N×M)", f"{len(ctx.instance.staff_ids) * len(ctx.instance.session_names):,}"))):
+        col.metric(lbl, val)
+    (st.success if result.satisfiable else st.error)("Hard rules H1 (Availability), H2 (No double-booking), and H3 (Exact capacity) are satisfiable."
+                                                     if result.satisfiable else f"UNSAT: minimal unsatisfiable core has {len(result.unsat_core)} constraints.")
+    st.dataframe(pd.DataFrame(result.sample_assignments if result.satisfiable else {"minimal_unsat_core_constraint": result.unsat_core}), use_container_width=True, hide_index=True)
+    st.caption("Propositional Logic to 0/1 Integer Linear Programming equivalence bridge")
+    st.dataframe(pd.DataFrame(result.summary_rows), use_container_width=True, hide_index=True)
+    return result
