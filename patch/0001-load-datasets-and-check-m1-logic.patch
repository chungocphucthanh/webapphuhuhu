+"""Shared dataset loading, seed configuration, and slicing for Module 5."""
+from __future__ import annotations
+from collections import Counter
+from dataclasses import dataclass, replace
+from datetime import date
+from pathlib import Path
+from random import Random
+import tempfile
+import pandas as pd
+import streamlit as st
+from m1_logic.data_loader import DEFAULT_PATH, PROJECT_FOLDER, load_dataset
+from m2_ilp.config import DEFAULT_AVAILABILITY, TEAM_ID, ModelConfig
+from m2_ilp.instance import DEFAULT_FLIP_RATE, Instance, build_instance, simulate_preferences, small_slice, toy_instance
+from m2_ilp.soft import fit_fatigue_k
+from tools.make_seed import seed_for
+
+DATASET_MODES: tuple[str, ...] = ("full", "subset", "toy")
+DEFAULT_SUBSET_DAYS: int = 7
+
+@dataclass(frozen=True)
+class DatasetContext:
+    mode: str
+    seed: int
+    data_dir: Path
+    instance: Instance
+    full_instance: Instance
+    config: ModelConfig
+    sessions_df: pd.DataFrame
+    invigilators_df: pd.DataFrame
+    is_live_solvable: bool
+
+def read_seed(path: Path | str | None = None) -> int:
+    """Read and validate a non-negative integer seed from data/seed.txt."""
+    target = PROJECT_FOLDER / "data" / "seed.txt" if path is None else Path(path)
+    if not target.is_file():
+        raise FileNotFoundError(f"Seed file not found: {target}")
+    text = target.read_text(encoding="utf-8-sig").strip()
+    if not text or not text.isdigit():
+        raise ValueError(f"Invalid non-negative integer seed in {target}: {text!r}")
+    return int(text)
+
+def derive_soft_weights(seed: int) -> tuple[float, float, float]:
+    """Derive deterministic (location, fatigue, travel) soft weights in [0.5, 2.0]."""
+    if isinstance(seed, bool) or not isinstance(seed, int) or seed < 0:
+        raise ValueError("seed must be a non-negative integer")
+    rng = Random(seed)
+    return tuple(round(rng.uniform(0.5, 2.0), 2) for _ in range(3))
+
+def derive_model_config(inst: Instance, *, time_limit: int = 15, stage: int = 1) -> ModelConfig:
+    """Fit daily fatigue threshold K from baseline and return a frozen ModelConfig."""
+    if isinstance(time_limit, bool) or not isinstance(time_limit, int) or time_limit <= 0:
+        raise ValueError("time_limit must be a positive integer")
+    return ModelConfig(stage=stage, fatigue_k=fit_fatigue_k(inst) if inst.baseline else 3, time_limit=time_limit)
+
+def build_seeded_instance(seed: int, *, data: dict | None = None, availability: str = DEFAULT_AVAILABILITY) -> Instance:
+    """Build an M2 Instance; delegates directly to build_instance for the canonical team seed."""
+    weights, raw, team_seed = list(derive_soft_weights(seed)), dict(load_dataset(DEFAULT_PATH) if data is None else data), seed_for(TEAM_ID)
+    if seed == team_seed:
+        return build_instance(seed, availability, data=raw)
+    base = build_instance(team_seed, "day" if availability == "seeded" else availability, data=raw)
+    pairs = base.A
+    if availability == "seeded":
+        codes, obs = sorted({c for c, _ in raw["session_ids"]}), {(i, raw["session_ids"][j][0]) for i, j in base.baseline}
+        rng, avail = Random(seed), set(obs)
+        avail.update((i, c) for i in sorted(range(len(base.staff_ids)), key=base.staff_ids.__getitem__)
+                     for c in codes if (i, c) not in obs and rng.random() < DEFAULT_FLIP_RATE)
+        pairs = {(i, j) for i in range(len(base.staff_ids)) for j, (c, _) in enumerate(raw["session_ids"]) if (i, c) in avail}
+    return replace(base, seed=seed, availability=availability, A=pairs, preferences=simulate_preferences(raw, seed),
+                   soft_weights=weights, flip_rate=DEFAULT_FLIP_RATE if availability == "seeded" else None)
+
+def slice_instance(inst: Instance, mode: str = "full", *, subset_days: int = DEFAULT_SUBSET_DAYS,
+                   start_date: date | None = None, end_date: date | None = None, max_sessions: int | None = None) -> Instance:
+    """Extract a validated full, subset, or toy Instance slice."""
+    if mode not in DATASET_MODES:
+        raise ValueError(f"mode must be one of {DATASET_MODES}, got {mode!r}")
+    if mode in ("full", "toy"):
+        toy = toy_instance() if mode == "toy" else None
+        return inst if mode == "full" else (toy if inst.seed == toy.seed else replace(toy, seed=inst.seed, soft_weights=list(derive_soft_weights(inst.seed))))
+    if start_date is None and end_date is None and max_sessions is None:
+        return small_slice(inst, n_days=subset_days)
+    lo, hi = start_date or min(inst.day), end_date or max(inst.day)
+    if (start_date is not None or end_date is not None) and lo > hi:
+        raise ValueError("start_date must not exceed end_date")
+    if start_date is None and end_date is None and (isinstance(max_sessions, bool) or not isinstance(max_sessions, int) or max_sessions < 1):
+        raise ValueError("max_sessions must be a positive integer")
+    sessions = [j for j, d in enumerate(inst.day) if lo <= d <= hi] if (start_date is not None or end_date is not None) else list(range(min(max_sessions, len(inst.session_names))))
+    if not sessions:
+        raise ValueError("Selected dataset slice contains no exam sessions")
+    smap = {old: new for new, old in enumerate(sessions)}
+    people = sorted({i for i, j in inst.A | set(inst.baseline) if j in smap})
+    pmap = {old: new for new, old in enumerate(people)}
+    return replace(inst, staff_ids=[inst.staff_ids[i] for i in people], session_names=[inst.session_names[j] for j in sessions],
+                   demand=[inst.demand[j] for j in sessions], campus=[inst.campus[j] for j in sessions], day=[inst.day[j] for j in sessions],
+                   intervals=[inst.intervals[j] for j in sessions], overlaps=[(smap[j], smap[k]) for j, k in inst.overlaps if j in smap and k in smap],
+                   baseline=[(pmap[i], smap[j]) for i, j in inst.baseline if j in smap], A={(pmap[i], smap[j]) for i, j in inst.A if j in smap},
+                   preferences=[inst.preferences[i] for i in people], soft_weights=list(inst.soft_weights))
+
+@st.cache_data(show_spinner=False)
+def load_dataset_context(mode: str = "full", seed: int | None = None, *, subset_days: int = DEFAULT_SUBSET_DAYS,
+                         start_date: date | None = None, end_date: date | None = None, max_sessions: int | None = None,
+                         csv_bytes: bytes | None = None, time_limit: int = 15) -> DatasetContext:
+    """Load, validate, slice, and cache the dataset context for all dashboard sections."""
+    resolved_seed = read_seed() if seed is None else seed
+    derive_soft_weights(resolved_seed)
+    if csv_bytes is not None and (not isinstance(csv_bytes, (bytes, bytearray)) or not bytes(csv_bytes).strip()):
+        raise ValueError("Uploaded CSV content must be non-empty bytes")
+    with tempfile.TemporaryDirectory() as folder:
+        src = DEFAULT_PATH if csv_bytes is None else Path(folder) / "u.csv"
+        if csv_bytes is not None:
+            src.write_bytes(bytes(csv_bytes))
+        full_inst = build_seeded_instance(resolved_seed, data=load_dataset(src))
+    inst = slice_instance(full_inst, mode, subset_days=subset_days, start_date=start_date, end_date=end_date, max_sessions=max_sessions)
+    avail_c, base_c = Counter(i for i, _ in inst.A), Counter(i for i, _ in inst.baseline)
+    sessions_df = pd.DataFrame([{"session_idx": j, "session_id": s, "campus": inst.campus[j], "day": inst.day[j].isoformat(),
+                                 "start": inst.intervals[j][0].strftime("%H:%M"), "end": inst.intervals[j][1].strftime("%H:%M"), "demand": inst.demand[j]} for j, s in enumerate(inst.session_names)])
+    invigilators_df = pd.DataFrame([{"staff_idx": i, "staff_id": p, "preference": inst.preferences[i], "available_sessions": avail_c[i], "baseline_load": base_c[i]} for i, p in enumerate(inst.staff_ids)])
+    return DatasetContext(mode, resolved_seed, PROJECT_FOLDER / "data", inst, full_inst, derive_model_config(inst, time_limit=time_limit), sessions_df, invigilators_df, mode in ("subset", "toy"))
