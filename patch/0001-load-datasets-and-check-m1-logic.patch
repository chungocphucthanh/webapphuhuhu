+"""Unit tests for Module 5 dataset context and Module 1 CNF/ILP section."""
+from __future__ import annotations
+from datetime import date
+import pytest
+from streamlit.testing.v1 import AppTest
+from app.data_context import DEFAULT_SUBSET_DAYS, PROJECT_FOLDER, build_seeded_instance, derive_soft_weights, load_dataset_context, read_seed, slice_instance
+from app.m1_section import build_logic_ilp_table, check_m1_feasibility
+from m2_ilp.config import TEAM_ID
+from tools.make_seed import seed_for, soft_weights
+
+def _m1_toy_page():
+    from app.data_context import load_dataset_context
+    from app.m1_section import render_m1_section
+    render_m1_section(load_dataset_context("toy"))
+
+def test_seed_and_weights(tmp_path):
+    assert read_seed() == seed_for(TEAM_ID) == 1358677812 and list(derive_soft_weights(1358677812)) == soft_weights(TEAM_ID)
+    with pytest.raises(FileNotFoundError):
+        read_seed(tmp_path / "missing.txt")
+    (tmp_path / "bad.txt").write_text("invalid\n", encoding="utf-8")
+    for fn in (lambda: read_seed(tmp_path / "bad.txt"), lambda: derive_soft_weights(-1), lambda: derive_soft_weights(True)):
+        with pytest.raises(ValueError):
+            fn()
+
+def test_strict_validation_errors():
+    inst = load_dataset_context("full").instance
+    for fn in (lambda: load_dataset_context("bad_mode"), lambda: load_dataset_context("toy", csv_bytes=b" "),
+               lambda: load_dataset_context("toy", csv_bytes=b"a,b\n1,2\n"),
+               lambda: slice_instance(inst, "subset", start_date=date(2026, 6, 10), end_date=date(2026, 5, 1)),
+               lambda: slice_instance(inst, "subset", start_date=date(2099, 1, 1), end_date=date(2099, 1, 2))):
+        with pytest.raises(ValueError):
+            fn()
+
+def test_dataset_context_modes_slices_and_upload():
+    toy_ctx, sub_ctx, full_ctx = load_dataset_context("toy"), load_dataset_context("subset", subset_days=DEFAULT_SUBSET_DAYS), load_dataset_context("full")
+    assert toy_ctx.is_live_solvable and (len(toy_ctx.sessions_df), len(toy_ctx.invigilators_df)) == (2, 3)
+    assert sub_ctx.is_live_solvable and 0 < len(sub_ctx.sessions_df) < len(sub_ctx.full_instance.session_names)
+    assert not full_ctx.is_live_solvable and (len(full_ctx.sessions_df), len(full_ctx.invigilators_df)) == (83, 73)
+    custom = build_seeded_instance(424242)
+    assert custom.seed == 424242 and custom.soft_weights == list(derive_soft_weights(424242)) and len(slice_instance(full_ctx.instance, "subset", max_sessions=4).session_names) == 4
+    d0 = full_ctx.instance.day[0]
+    assert all(d == d0 for d in slice_instance(full_ctx.instance, "subset", start_date=d0, end_date=d0).day)
+    assert len(load_dataset_context("full", csv_bytes=(PROJECT_FOLDER / "data/m1_cases/real_slice.csv").read_bytes()).sessions_df) > 0
+
+def test_m1_sat_unsat_bridge_and_render():
+    toy_ctx = load_dataset_context("toy")
+    sat_res, unsat_res = check_m1_feasibility(toy_ctx), check_m1_feasibility(toy_ctx, force_unsat=True)
+    assert sat_res.satisfiable and sat_res.unsat_core == () and all(len(str(r["assigned_staff"]).split(", ")) == r["demand"] for r in sat_res.sample_assignments)
+    assert not unsat_res.satisfiable and sum(x.startswith("Busy(") for x in unsat_res.unsat_core) == 2 and any(x.startswith("capacity(Morning)=2") for x in unsat_res.unsat_core)
+    with pytest.raises(ValueError):
+        check_m1_feasibility(toy_ctx, extra_busy=((99, 0),))
+    rows = {r["rule"]: r for r in build_logic_ilp_table(toy_ctx)}
+    assert check_m1_feasibility(load_dataset_context("subset")).satisfiable and rows["H1 Availability"]["linear_ilp"] == "x_ij == 0" and rows["H3 Exact capacity"]["active_rows"] == "2"
+    at = AppTest.from_function(_m1_toy_page).run()
+    assert not at.exception and at.metric[0].value == "SAT"
