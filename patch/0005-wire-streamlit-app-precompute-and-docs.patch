+"""End-to-end AppTest and run_all.py determinism checks for Module 5."""
+from __future__ import annotations
+import json, subprocess, sys
+from pathlib import Path
+import pytest
+from streamlit.testing.v1 import AppTest
+from app.data_context import read_seed
+from app.m2_section import DEFAULT_M2_PATH
+from app.precompute import build_m5_summary, run_m5
+
+ROOT_DIR = Path(__file__).resolve().parents[2]
+APP_PATH = ROOT_DIR / "app" / "app.py"
+
+
+def test_unified_single_page_dashboard_initial_load_and_slice_switch():
+    at = AppTest.from_file(str(APP_PATH)).run(timeout=30)
+    assert not at.exception
+    subheaders = [s.value for s in at.subheader]
+    assert len(subheaders) == 4 and all(tag in " ".join(subheaders) for tag in ("M1.", "M2.", "M3.", "M4."))
+    metrics = {m.label: m.value for m in at.metric}
+    assert (metrics["Dataset Slice"], metrics["Invigilators"], metrics["Exam Sessions"]) == ("FULL", "73", "83")
+    assert metrics["CNF Status"] == "SAT" and metrics["Active Schedule"] == "M2"
+    assert metrics["Schedule valid (DFA-accepted)"] in ("Yes", "No")
+    assert "Calibrated (a, b, r)" in metrics and "Stability (|a| < 1)" in metrics
+    assert len(at.dataframe) >= 6 and len(at.get("imgs")) >= 2
+    at.sidebar.selectbox(key="cfg_mode").select("toy").run(timeout=20)
+    assert not at.exception
+    toy = {m.label: m.value for m in at.metric}
+    assert (toy["Dataset Slice"], toy["Invigilators"], toy["Exam Sessions"]) == ("TOY", "3", "2")
+
+
+def test_run_all_stage_m5_byte_deterministic_and_non_mutating(tmp_path):
+    seed, m2_before = read_seed(), DEFAULT_M2_PATH.read_bytes()
+    cmd = [sys.executable, str(ROOT_DIR / "run_all.py"), "--seed", str(seed), "--stage", "m5"]
+    run1 = subprocess.run(cmd, cwd=ROOT_DIR, capture_output=True, check=True)
+    run2 = subprocess.run(cmd, cwd=ROOT_DIR, capture_output=True, check=True)
+    assert run1.stdout == run2.stdout and run1.stderr == run2.stderr == b"" and DEFAULT_M2_PATH.read_bytes() == m2_before
+    parsed = json.loads(run1.stdout.decode("utf-8"))
+    assert parsed == build_m5_summary(seed) and parsed["m1"]["satisfiable"] is True and parsed["m2"]["max_load"] == 11
+    out_a, out_b = tmp_path / "a.json", tmp_path / "b.json"
+    run_m5(seed, out_path=out_a)
+    run_m5(seed, out_path=out_b)
+    assert out_a.read_bytes() == out_b.read_bytes() and b"\r\n" not in out_a.read_bytes()
+    with pytest.raises(ValueError):
+        build_m5_summary(-1)
