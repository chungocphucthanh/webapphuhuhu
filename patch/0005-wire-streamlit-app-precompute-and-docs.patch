+"""Deterministic Module 5 CLI verification and summary generator for run_all.py."""
+from __future__ import annotations
+import argparse, hashlib, json, logging, sys
+from pathlib import Path
+import numpy as np
+import streamlit.logger
+
+ROOT_DIR = Path(__file__).resolve().parents[1]
+if str(ROOT_DIR) not in sys.path:
+    sys.path.insert(0, str(ROOT_DIR))
+for _name in ("streamlit.runtime.caching.cache_data_api", "streamlit.runtime.scriptrunner_utils.script_run_context"):
+    streamlit.logger.get_logger(_name).setLevel(logging.ERROR)
+
+from app.data_context import DEFAULT_PATH, load_dataset_context, read_seed
+from app.m1_section import check_m1_feasibility
+from app.m2_section import DEFAULT_M2_PATH, evaluate_m2_schedules
+from app.m3_section import check_m3_schedule
+from app.m4_section import evaluate_m4_dynamics
+
+
+def build_m5_summary(seed: int) -> dict[str, object]:
+    """Validate M1-M4 dashboard adapters for `seed` and return a deterministic summary."""
+    ctx = load_dataset_context("full", seed=seed)
+    m1, m2 = check_m1_feasibility(ctx), evaluate_m2_schedules(ctx, source="m2")
+    m3, m4 = check_m3_schedule(ctx.instance, m2.assignment), evaluate_m4_dynamics(ctx, m2, weeks=52, delta_f0=1.0)
+    if not m1.satisfiable or not m2.feasible:
+        raise RuntimeError("M5 verification failed: full dataset M1/M2 check is infeasible")
+    r123 = m3.rule_summaries[-1]
+    return {
+        "module": "m5", "seed": ctx.seed,
+        "dataset_sha256": hashlib.sha256(Path(DEFAULT_PATH).read_bytes()).hexdigest(),
+        "m2_schedule_sha256": hashlib.sha256(DEFAULT_M2_PATH.read_bytes()).hexdigest() if DEFAULT_M2_PATH.is_file() else None,
+        "staff": len(ctx.instance.staff_ids), "sessions": len(ctx.instance.session_names), "total_demand": int(sum(ctx.instance.demand)),
+        "m1": {"satisfiable": m1.satisfiable, "num_vars": m1.num_vars, "num_clauses": m1.num_clauses},
+        "m2": {"source": m2.source_name, "feasible": m2.feasible, "max_load": int(m2.metrics["max_load"]),
+               "baseline_max_load": int(m2.baseline_metrics["max_load"]), "l1": round(float(m2.metrics["l1"]), 6)},
+        "m3": {"schedule_valid_dfa_accepted": m3.all_accepted, "accepted_staff": int(r123["accepted"]),
+               "rejected_staff": int(r123["rejected"]), "minimal_product_states": int(r123["states"]), "rule_violations": len(m3.violations)},
+        "m4": {"a": round(float(m4.parameters.a), 8), "b": round(float(m4.parameters.b), 8),
+               "stability": str(m4.stability_info["classification"]), "threshold": round(float(m4.threshold), 8),
+               "baseline_spread": round(float(np.ptp(m4.equilibria["baseline"])), 8),
+               "m2_spread": round(float(np.ptp(m4.equilibria["m2"])), 8),
+               "m4_spread": round(float(np.ptp(m4.equilibria["fatigue_aware"])), 8),
+               "m4_threshold_excess": round(float(m4.threshold_penalties["fatigue_aware"]), 8)},
+    }
+
+
+def serialize_m5_summary(summary: dict[str, object]) -> str:
+    """Serialize summary with sorted keys, LF newline, and strict NaN/Inf rejection."""
+    return json.dumps(summary, indent=2, sort_keys=True, allow_nan=False) + "\n"
+
+
+def run_m5(seed: int, out_path: Path | str | None = None) -> dict[str, object]:
+    """Run deterministic M5 verification; optionally write LF JSON to `out_path`."""
+    summary, payload = (s := build_m5_summary(seed)), serialize_m5_summary(s)
+    if out_path is not None:
+        (target := Path(out_path)).parent.mkdir(parents=True, exist_ok=True)
+        target.write_text(payload, encoding="utf-8", newline="\n")
+    sys.stdout.write(payload)
+    return summary
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--seed", type=int, default=None, help="defaults to data/seed.txt")
+    ap.add_argument("--out", type=Path, default=None, help="optional output JSON path")
+    args = ap.parse_args()
+    run_m5(read_seed() if args.seed is None else args.seed, out_path=args.out)
+
+
+if __name__ == "__main__":
+    main()
