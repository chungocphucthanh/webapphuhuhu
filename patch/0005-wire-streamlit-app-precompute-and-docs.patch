+"""Unified single-page Streamlit dashboard integrating CO2011 Modules 1-4."""
+from __future__ import annotations
+from pathlib import Path
+import sys
+import streamlit as st
+
+ROOT_DIR = Path(__file__).resolve().parents[1]
+if str(ROOT_DIR) not in sys.path:
+    sys.path.insert(0, str(ROOT_DIR))
+
+from app.data_context import DATASET_MODES, DEFAULT_SUBSET_DAYS, load_dataset_context, read_seed
+from app.m1_section import render_m1_section
+from app.m2_section import render_m2_section
+from app.m3_section import render_m3_section
+from app.m4_section import render_m4_section
+
+SOURCE_LABELS = {"m2": "M2 0/1 ILP schedule", "m4": "M4 fatigue-aware schedule",
+                 "baseline": "Historical baseline", "live": "Live bounded CBC solve", "uploaded": "Uploaded CSV schedule"}
+
+
+def render_dashboard() -> None:
+    """Render sidebar controls, overview KPI ribbon, and M1-M4 sections on one page."""
+    st.set_page_config(page_title="CO2011 IAP — Unified M1–M5 Dashboard", layout="wide")
+    st.title("CO2011 Invigilator Assignment — Unified Module 1–5 Dashboard")
+    st.caption("Single-page decision-support interface linking M1 Logic/SAT, M2 0/1 ILP, M3 DFA rules, and M4 vector fatigue dynamics.")
+    default_seed = read_seed()
+    with st.sidebar:
+        st.header("Configuration & Inputs")
+        mode = st.selectbox("Dataset slice", list(DATASET_MODES), index=0, key="cfg_mode")
+        seed = int(st.number_input("Team seed", min_value=0, value=default_seed, step=1, key="cfg_seed"))
+        subset_days = st.slider("Subset horizon (days)", 1, 27, DEFAULT_SUBSET_DAYS, key="cfg_subset_days") if mode == "subset" else DEFAULT_SUBSET_DAYS
+        time_limit = int(st.slider("Live CBC time limit (s)", 5, 60, 15, 5, key="cfg_time_limit"))
+        allowed = ["m2", "m4", "baseline", "uploaded"] if mode == "full" else ["live", "m2", "m4", "baseline", "uploaded"]
+        source = st.selectbox("Active schedule source", allowed, format_func=SOURCE_LABELS.get, key=f"cfg_source_{mode}")
+        dataset_upload = st.file_uploader("Custom dataset CSV (optional)", type=["csv"], key="cfg_dataset_csv")
+        schedule_upload = st.file_uploader("Schedule CSV (dense M2 format)", type=["csv"], key="cfg_schedule_csv")
+
+    try:
+        ctx = load_dataset_context(mode, seed=seed, subset_days=subset_days,
+                                   csv_bytes=dataset_upload.getvalue() if dataset_upload is not None else None, time_limit=time_limit)
+    except ValueError as exc:
+        st.error(f"Dataset validation error: {exc}")
+        ctx = load_dataset_context(mode, seed=default_seed, subset_days=subset_days, time_limit=time_limit)
+
+    sched_bytes = schedule_upload.getvalue() if schedule_upload is not None else None
+    active_source = "uploaded" if sched_bytes is not None else ("m2" if source == "uploaded" else source)
+    for col, (lbl, val) in zip(st.columns(5), (
+        ("Dataset Slice", ctx.mode.upper()), ("Invigilators", str(len(ctx.instance.staff_ids))),
+        ("Exam Sessions", str(len(ctx.instance.session_names))), ("Total Demand", str(sum(ctx.instance.demand))),
+        ("Weights (LOC/FAT/TRV)", "/".join(f"{w:.2f}" for w in ctx.instance.soft_weights)),
+    )):
+        col.metric(lbl, val)
+    with st.expander("Inspect Loaded Sessions & Invigilator Availability", expanded=False):
+        c_sess, c_inv = st.columns(2)
+        c_sess.dataframe(ctx.sessions_df, use_container_width=True, hide_index=True)
+        c_inv.dataframe(ctx.invigilators_df, use_container_width=True, hide_index=True)
+    st.divider()
+    render_m1_section(ctx)
+    st.divider()
+    selection = render_m2_section(ctx, source=active_source, uploaded_csv=sched_bytes, time_limit=time_limit)
+    st.divider()
+    render_m3_section(ctx, selection, time_limit=time_limit)
+    st.divider()
+    render_m4_section(ctx, selection)
+
+
+if __name__ == "__main__":
+    render_dashboard()
