@@ -0,0 +1,64 @@
+"""Unit tests for Module 2 schedule solving, validation, comparison, and weekly filtering."""
+from __future__ import annotations
+import pytest
+from streamlit.testing.v1 import AppTest
+from app.data_context import load_dataset_context
+from app.m2_section import evaluate_m2_schedules, filter_weekly_rows, parse_uploaded_schedule, solve_bounded_m2
+from m2_ilp.validate import check_schedule
+
+def _m2_subset_page():
+    from app.data_context import load_dataset_context
+    from app.m2_section import render_m2_section
+    render_m2_section(load_dataset_context("subset"), source="live", time_limit=10)
+
+def _dense_csv(inst, assigned) -> str:
+    return "invigilator_id,session_id,assigned\n" + "\n".join(f"{s},{c},{int((i, j) in assigned)}" for i, s in enumerate(inst.staff_ids) for j, c in enumerate(inst.session_names)) + "\n"
+
+def test_live_bounded_solve_on_toy_and_subset_and_full_guard():
+    toy_ctx = load_dataset_context("toy")
+    toy_assigned = solve_bounded_m2(toy_ctx, time_limit=5)
+    assert check_schedule(toy_ctx.instance, toy_assigned) == [] and len(toy_assigned) == sum(toy_ctx.instance.demand) and (0, 1) in toy_assigned
+    sub_sel = evaluate_m2_schedules(load_dataset_context("subset"), source="live", time_limit=10)
+    assert sub_sel.feasible and sub_sel.metrics["max_load"] < sub_sel.baseline_metrics["max_load"] and sub_sel.metrics["l1"] < sub_sel.baseline_metrics["l1"]
+    with pytest.raises(ValueError, match="toy and subset"):
+        solve_bounded_m2(load_dataset_context("full"), time_limit=10)
+    for bad_limit in (0, -3, True, 999):
+        with pytest.raises(ValueError, match="time_limit"):
+            solve_bounded_m2(toy_ctx, time_limit=bad_limit)
+
+def test_full_comparison_superiority_and_clean_clone_fallbacks(tmp_path):
+    full_ctx = load_dataset_context("full")
+    sel = evaluate_m2_schedules(full_ctx, m4_path=tmp_path / "absent_m4.csv")
+    assert sel.feasible and sel.source_name == "m2" and sel.metrics["max_load"] < sel.baseline_metrics["max_load"] and sel.metrics["l1"] < sel.baseline_metrics["l1"]
+    by_name = {row["schedule"]: row for row in sel.comparison_rows}
+    assert not by_name["baseline"]["beats_baseline"] and by_name["m2"]["beats_baseline"] and by_name["m4"]["beats_baseline"]
+    clean = evaluate_m2_schedules(full_ctx, m2_path=tmp_path / "no_m2.csv", m4_path=tmp_path / "no_m4.csv")
+    assert clean.feasible and clean.m2_assignment == clean.baseline_assignment
+
+def test_uploaded_csv_validation_and_malformed_rejection():
+    toy_ctx = load_dataset_context("toy")
+    valid = solve_bounded_m2(toy_ctx, time_limit=5)
+    csv_text = _dense_csv(toy_ctx.instance, valid)
+    assert parse_uploaded_schedule(toy_ctx.instance, csv_text.encode("utf-8")) == valid
+    sel = evaluate_m2_schedules(toy_ctx, source="uploaded", uploaded_csv=csv_text)
+    assert sel.feasible and sel.source_name == "uploaded" and sel.assignment == valid
+    for bad_csv in ("staff,session,assigned\nCB1,Morning,1\n", csv_text.replace("CB1,Morning,0", "CB999,Morning,0"),
+                    csv_text.replace("CB1,Afternoon,1", "CB1,Afternoon,2"), "\n".join(csv_text.splitlines()[:-1]) + "\n", _dense_csv(toy_ctx.instance, frozenset())):
+        with pytest.raises(ValueError):
+            parse_uploaded_schedule(toy_ctx.instance, bad_csv)
+    with pytest.raises(ValueError):
+        evaluate_m2_schedules(toy_ctx, source="uploaded", uploaded_csv=None)
+
+def test_weekly_assignment_table_filters_and_render():
+    full_ctx = load_dataset_context("full")
+    rows = evaluate_m2_schedules(full_ctx).weekly_rows
+    assert len(rows) == sum(full_ctx.instance.demand) and {r["week"] for r in rows} == {1, 2, 3, 4}
+    assert sum(len(filter_weekly_rows(rows, week=w)) for w in range(1, 5)) == len(rows) and sum(len(filter_weekly_rows(rows, campus=c)) for c in ("CS1", "CS2")) == len(rows)
+    s = rows[0]
+    exact = filter_weekly_rows(rows, week=int(s["week"]), campus=str(s["campus"]), session_id=str(s["session_id"]), invigilator_id=str(s["invigilator_id"]))
+    assert len(exact) == 1 and exact[0] == s
+    for kwargs in ({"week": 0}, {"week": True}, {"campus": "CS3"}):
+        with pytest.raises(ValueError):
+            filter_weekly_rows(rows, **kwargs)
+    at = AppTest.from_function(_m2_subset_page).run()
+    assert not at.exception and at.metric[0].value == "LIVE" and len(at.dataframe) == 2
