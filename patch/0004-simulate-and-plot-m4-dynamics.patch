+"""Unit tests for Module 5 M4 vector fatigue dynamics, fairness curves, and plots."""
+
+from __future__ import annotations
+
+import matplotlib.pyplot as plt
+import numpy as np
+import pytest
+from streamlit.testing.v1 import AppTest
+
+from app.data_context import load_dataset_context
+import app.m4_section as m4_mod
+from app.m4_section import REGIME_LABELS, build_fairness_figure, build_trajectory_figure, evaluate_m4_dynamics
+
+
+def _m4_toy_page():
+    from app.data_context import load_dataset_context
+    from app.m4_section import render_m4_section
+    render_m4_section(load_dataset_context("toy"), weeks=20)
+
+
+@pytest.fixture(scope="module")
+def full_summary():
+    return evaluate_m4_dynamics(load_dataset_context("full"), weeks=52, delta_f0=2.5)
+
+
+def test_clean_clone_in_memory_calibration_and_stability(tmp_path, monkeypatch):
+    real_m4, real_before = m4_mod.M4_DIR, sorted(p.name for p in m4_mod.M4_DIR.iterdir())
+    monkeypatch.setattr(m4_mod, "M4_DIR", tmp_path)
+    s = evaluate_m4_dynamics(load_dataset_context("full"), weeks=52, delta_f0=2.5)
+    assert list(tmp_path.iterdir()) == [] and sorted(p.name for p in real_m4.iterdir()) == real_before
+    assert s.parameters.a == pytest.approx(0.27063439, abs=1e-6) and s.parameters.b == pytest.approx(1.0 - s.parameters.a) and s.parameters.r == 0.0
+    assert s.stability_info == {"jacobian": "a I", "spectral_radius": abs(s.parameters.a), "classification": "asymptotically stable"}
+    assert s.workloads["baseline"].days.tolist() == [7, 7, 7, 6] and s.threshold == pytest.approx(5.6603276, abs=1e-5)
+    assert all(float(eq.mean()) == pytest.approx(769 * 7 / (73 * 27), abs=1e-8) for eq in s.equilibria.values())
+
+
+def test_fairness_curves_and_perturbation_contraction(full_summary):
+    assert {"baseline", "m2", "fatigue_aware", "equal_load"}.issubset(full_summary.trajectories)
+    n, a = np.arange(53), full_summary.parameters.a
+    np.testing.assert_allclose(full_summary.spread_curves["equal_load"], full_summary.spread_curves["equal_load"][0] * (abs(a) ** n), atol=1e-12)
+    np.testing.assert_allclose(full_summary.variance_curves["equal_load"], full_summary.variance_curves["equal_load"][0] * (a ** (2 * n)), atol=1e-12)
+    assert full_summary.spread_curves["equal_load"][-1] < 1e-10 and np.ptp(full_summary.equilibria["m2"]) < np.ptp(full_summary.equilibria["baseline"])
+    assert np.ptp(full_summary.equilibria["fatigue_aware"]) <= np.ptp(full_summary.equilibria["m2"]) + 1e-9
+    assert full_summary.threshold_penalties["fatigue_aware"] == pytest.approx(0.0, abs=1e-6)
+    assert full_summary.threshold_penalties["fatigue_aware"] < full_summary.threshold_penalties["baseline"]
+    np.testing.assert_allclose(full_summary.perturbation_decay, 2.5 * (abs(a) ** n), atol=1e-12)
+    np.testing.assert_allclose(full_summary.perturbation_decay, full_summary.predicted_decay, atol=1e-12)
+
+
+def test_slices_figures_and_apptest(full_summary):
+    sub = evaluate_m4_dynamics(load_dataset_context("subset"), weeks=20, delta_f0=1.0)
+    assert sub.trajectories["fatigue_aware"].shape == (21, len(sub.staff_ids))
+    fig1, fig2 = build_fairness_figure(full_summary), build_trajectory_figure(full_summary)
+    assert len(fig1.axes) == 2 and len(fig2.axes) == 2 and len(fig2.axes[0].collections) >= 1
+    assert all(REGIME_LABELS[k] in [ln.get_label() for ln in fig1.axes[0].lines] for k in ("baseline", "m2", "fatigue_aware", "equal_load"))
+    labels2 = [ln.get_label() for ln in fig2.axes[0].lines]
+    assert "Mean trajectory" in labels2 and "Soft threshold H" in labels2 and len(fig2.axes[1].lines) >= 4
+    plt.close("all")
+    at = AppTest.from_function(_m4_toy_page).run()
+    assert not at.exception and len(at.metric) == 4
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"weeks": 0}, {"weeks": -4}, {"weeks": True}, {"weeks": 500}, {"delta_f0": -0.5},
+    {"delta_f0": float("nan")}, {"delta_f0": float("inf")}, {"delta_f0": True},
+    {"perturbation_staff": "UNKNOWN"}, {"regime": "invalid"}, {"selection": [(0, 0)]}])
+def test_invalid_horizons_perturbations_and_schedules_raise_value_error(kwargs):
+    ctx = load_dataset_context("toy")
+    with pytest.raises(ValueError):
+        evaluate_m4_dynamics(ctx, **kwargs)
+    with pytest.raises(ValueError, match="at least two"):
+        evaluate_m4_dynamics(ctx, allow_reference_calibration=False)
