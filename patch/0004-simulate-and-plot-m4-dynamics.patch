+"""Module 4 dashboard section: vector fatigue dynamics, equilibria, and fairness."""
+from __future__ import annotations
+from dataclasses import dataclass
+import math
+from pathlib import Path
+import matplotlib
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import numpy as np
+import pandas as pd
+import streamlit as st
+from app.data_context import DatasetContext
+from m2_ilp.config import M2_DIR, ModelConfig
+from m2_ilp.soft import fit_fatigue_k
+from m2_ilp.solve import solve
+from m2_ilp.validate import check_schedule
+from m4_dynamics.fatigue import (FatigueParameters, calibrate, fit_threshold, fixed_point,
+                                 simulate, simulate_history, stability, threshold_penalty)
+from m4_dynamics.planning import refine_schedule
+from m4_dynamics.workload import WeeklyWorkload, read_schedule, weekly_workload
+
+M4_DIR = Path(__file__).resolve().parents[1] / "m4_dynamics"
+REGIME_LABELS = {"baseline": "Baseline", "m2": "M2", "fatigue_aware": "M4 fatigue-aware",
+                 "equal_load": "Equal-load reference", "active": "Active schedule"}
+
+
+@dataclass(frozen=True)
+class M4DynamicsSummary:
+    parameters: FatigueParameters
+    calibration: dict[str, object]
+    stability_info: dict[str, object]
+    threshold: float
+    weeks: int
+    regime: str
+    staff_ids: tuple[str, ...]
+    workloads: dict[str, WeeklyWorkload]
+    histories: dict[str, np.ndarray]
+    trajectories: dict[str, np.ndarray]
+    equilibria: dict[str, np.ndarray]
+    spread_curves: dict[str, np.ndarray]
+    variance_curves: dict[str, np.ndarray]
+    threshold_penalties: dict[str, float]
+    perturbation_staff: str
+    delta_f0: float
+    perturbed_trajectory: np.ndarray
+    perturbation_decay: np.ndarray
+    predicted_decay: np.ndarray
+
+
+def _extract_selection(inst, selection: object | None):
+    if selection is None:
+        return frozenset(inst.baseline), None, None, None
+    if not hasattr(selection, "assignment"):
+        weekly_workload(inst, selection)
+        return frozenset(inst.baseline), None, None, frozenset(selection)
+    valid = lambda a: (frozenset(c) if (c := getattr(selection, a, None)) is not None and not check_schedule(inst, c) else None)
+    return (valid("baseline_assignment") or frozenset(inst.baseline), valid("m2_assignment"),
+            valid("m4_assignment"), valid("assignment") if getattr(selection, "feasible", True) else None)
+
+
+@st.cache_data(show_spinner=False)
+def _cached_m4_workloads(inst, full_inst, mode: str, time_limit: int, allow_ref: bool,
+                         m4_dir_str: str, base_set: frozenset, m2_set: frozenset | None, m4_set: frozenset | None):
+    is_full = mode == "full" and (len(inst.staff_ids), len(inst.session_names), inst.seed) == (73, 83, 1358677812)
+    def read_opt(path: Path) -> frozenset | None:
+        try:
+            return read_schedule(inst, path) if is_full and path.is_file() else None
+        except ValueError:
+            return None
+    baseline = weekly_workload(inst, base_set)
+    try:
+        params, cal, source = *calibrate(baseline), "active_slice"
+    except ValueError:
+        if not allow_ref or mode == "full" or full_inst is None:
+            raise
+        params, cal, source = *calibrate(weekly_workload(full_inst, full_inst.baseline)), "full_reference"
+    threshold = fit_threshold(simulate_history(baseline, params))
+    m2_set = m2_set or read_opt(M2_DIR / "schedule.csv") or solve(inst, ModelConfig(fatigue_k=fit_fatigue_k(inst), time_limit=time_limit)).assigned
+    if not m2_set:
+        raise ValueError("Unable to solve a feasible M2 schedule for M4 dynamics")
+    m4_set = m4_set or read_opt(Path(m4_dir_str) / "fatigue_aware_schedule.csv") or refine_schedule(inst, m2_set, params, threshold)[0]
+    wls = {"baseline": baseline, "m2": weekly_workload(inst, m2_set), "fatigue_aware": weekly_workload(inst, m4_set)}
+    return params, {**cal, "calibration_source": source}, threshold, wls, (base_set, m2_set, m4_set)
+
+
+def evaluate_m4_dynamics(ctx: DatasetContext, selection: object | None = None, *, weeks: int = 52, delta_f0: float = 1.0,
+                         perturbation_staff: str | None = None, regime: str = "fatigue_aware", allow_reference_calibration: bool = True) -> M4DynamicsSummary:
+    """Compute calibrated Direction B dynamics, 52-week equilibria, and impulse contraction."""
+    inst = ctx.instance
+    if type(weeks) is not int or not 1 <= weeks <= 260:
+        raise ValueError("Simulation horizon weeks must be an integer in [1, 260]")
+    if isinstance(delta_f0, bool) or not isinstance(delta_f0, (int, float)) or not math.isfinite(delta_f0) or delta_f0 < 0:
+        raise ValueError("Initial perturbation delta_f0 must be a finite nonnegative number")
+    staff_id = inst.staff_ids[0] if perturbation_staff is None else perturbation_staff
+    if staff_id not in inst.staff_ids or regime not in REGIME_LABELS:
+        raise ValueError(f"Invalid invigilator {staff_id!r} or regime {regime!r}")
+    base_s, m2_s, m4_s, active_s = _extract_selection(inst, selection)
+    params, cal, threshold, wls, known = _cached_m4_workloads(
+        inst, ctx.full_instance, ctx.mode, ctx.config.time_limit, allow_reference_calibration, str(M4_DIR), base_s, m2_s, m4_s)
+    wls = {**wls, **({"active": weekly_workload(inst, active_s)} if active_s and (active_s not in known or regime == "active") else {})}
+    if regime not in wls and regime != "equal_load":
+        raise ValueError(f"Regime {regime!r} requires a valid schedule")
+    histories = {n: simulate_history(wl, params) for n, wl in wls.items()}
+    init = histories["baseline"][-1]
+    loads = {**{n: wl.mean_load for n, wl in wls.items()}, "equal_load": np.full(len(inst.staff_ids), float(wls["baseline"].mean_load.mean()))}
+    equilibria = {n: fixed_point(ld, params) for n, ld in loads.items()}
+    trajectories = {n: simulate(ld, params, initial=init, weeks=weeks) for n, ld in loads.items()}
+    perturbed = simulate(loads[regime], params, initial=init + np.eye(len(inst.staff_ids))[inst.staff_ids.index(staff_id)] * float(delta_f0), weeks=weeks)
+    return M4DynamicsSummary(
+        params, cal, stability(params), threshold, weeks, regime, tuple(inst.staff_ids), wls, histories, trajectories,
+        equilibria, {n: np.ptp(tr, axis=1) for n, tr in trajectories.items()}, {n: np.var(tr, axis=1) for n, tr in trajectories.items()},
+        {n: threshold_penalty(h, threshold) for n, h in histories.items()}, staff_id, float(delta_f0), perturbed,
+        np.max(np.abs(perturbed - trajectories[regime]), axis=1), abs(float(delta_f0)) * (abs(params.a) ** np.arange(weeks + 1)))
+
+
+def _style_figure(fig: plt.Figure, axes, fontsize: float = 8.0) -> plt.Figure:
+    for ax in axes:
+        ax.grid(alpha=0.25)
+        ax.legend(fontsize=fontsize)
+    fig.tight_layout()
+    return fig
+
+
+def build_fairness_figure(summary: M4DynamicsSummary) -> plt.Figure:
+    """Plot 52-week fatigue spread (max - min) and variance Var(F_n) across regimes."""
+    fig, axes = plt.subplots(1, 2, figsize=(11, 3.5))
+    t = np.arange(summary.weeks + 1)
+    for name in summary.trajectories:
+        axes[0].plot(t, summary.spread_curves[name], label=REGIME_LABELS[name])
+        axes[1].plot(t, summary.variance_curves[name], label=REGIME_LABELS[name])
+    axes[0].set(title="Fatigue Spread (max - min)", xlabel="Week n", ylabel="Spread")
+    axes[1].set(title="Fatigue Variance Var(F_n)", xlabel="Week n", ylabel="Variance")
+    return _style_figure(fig, axes, 8.0)
+
+
+def build_trajectory_figure(summary: M4DynamicsSummary) -> plt.Figure:
+    """Plot invigilator band, mean/equilibrium F*, perturbation, and observed history vs H."""
+    fig, axes = plt.subplots(1, 2, figsize=(11, 3.5))
+    t, traj, idx = np.arange(summary.weeks + 1), summary.trajectories[summary.regime], summary.staff_ids.index(summary.perturbation_staff)
+    axes[0].fill_between(t, traj.min(axis=1), traj.max(axis=1), alpha=0.22, label="Invigilator min-max band")
+    axes[0].plot(t, traj.mean(axis=1), linewidth=1.8, label="Mean trajectory")
+    axes[0].axhline(float(summary.equilibria[summary.regime].mean()), color="black", linestyle=":", label="Mean equilibrium F*")
+    axes[0].axhline(summary.threshold, color="crimson", linestyle="--", linewidth=1.0, label="Soft threshold H")
+    axes[0].plot(t, summary.perturbed_trajectory[:, idx], linestyle="-.", label=f"Perturbed {summary.perturbation_staff} (+{summary.delta_f0:g})")
+    axes[0].set(title=f"Equilibrium & Impulse ({REGIME_LABELS[summary.regime]})", xlabel="Week n", ylabel="Fatigue proxy")
+    for name, hist in summary.histories.items():
+        axes[1].plot(np.arange(len(hist)), hist.max(axis=1), marker="o", label=REGIME_LABELS[name])
+    axes[1].axhline(summary.threshold, color="crimson", linestyle="--", linewidth=1.0, label="Soft threshold H")
+    axes[1].set(title="Observed Multi-Week Peak Fatigue", xlabel="Observed week block k", ylabel="Max fatigue proxy")
+    return _style_figure(fig, axes, 7.5)
+
+
+def render_m4_section(ctx: DatasetContext, selection: object | None = None, *, weeks: int = 52) -> M4DynamicsSummary:
+    """Render M4 Direction B fairness, equilibrium, and perturbation diagnostics."""
+    st.subheader("M4. Vector Fatigue Dynamics, Equilibrium & Fairness")
+    if selection is not None and not getattr(selection, "feasible", True):
+        st.warning("Active schedule violates hard rules; showing validated Baseline, M2, and M4 regimes.")
+    c1, c2, c3 = st.columns(3)
+    regime = c1.selectbox("Trajectory regime", ["fatigue_aware", "m2", "baseline", "equal_load"], format_func=REGIME_LABELS.get, key=f"m4_regime_{ctx.mode}")
+    staff_id = c2.selectbox("Perturbed invigilator", list(ctx.instance.staff_ids), key=f"m4_staff_{ctx.mode}")
+    delta_f0 = c3.slider("Initial impulse delta_f0", 0.0, 5.0, 1.5, 0.5, key="m4_delta_f0")
+    s, p = (res := evaluate_m4_dynamics(ctx, selection, weeks=weeks, delta_f0=delta_f0, perturbation_staff=staff_id, regime=regime)), res.parameters
+    for col, (lbl, val, delta) in zip(st.columns(4), [
+        ("Calibrated (a, b, r)", f"{p.a:.3f}, {p.b:.3f}, {p.r:.1f}", None),
+        ("Stability (|a| < 1)", str(s.stability_info["classification"]), f"|a| = {abs(p.a):.4f}"),
+        ("Soft threshold H (95%)", f"{s.threshold:.3f}", f"M4 excess = {s.threshold_penalties['fatigue_aware']:.2f}"),
+        ("Equilibrium spread F*", f"{float(np.ptp(s.equilibria['fatigue_aware'])):.3f}", f"vs Baseline {float(np.ptp(s.equilibria['baseline'])):.3f}")]):
+        col.metric(lbl, val, delta)
+    st.dataframe(pd.DataFrame([{"Regime": REGIME_LABELS[n], "Mean F*": round(float(s.equilibria[n].mean()), 4), "Spread(F*)": round(float(np.ptp(s.equilibria[n])), 4),
+                                "Var(F*)": round(float(np.var(s.equilibria[n])), 4), "52w Spread": round(float(s.spread_curves[n][-1]), 4),
+                                "Observed Excess (>H)": None if n not in s.threshold_penalties else round(s.threshold_penalties[n], 4)} for n in s.trajectories]),
+                 use_container_width=True, hide_index=True)
+    for fig in (build_fairness_figure(s), build_trajectory_figure(s)):
+        st.pyplot(fig)
+        plt.close(fig)
+    st.caption(f"F[n+1] = a F[n] + b load - r rest ({s.calibration['calibration_source']}); impulse +{s.delta_f0:g} on "
+               f"{s.perturbation_staff} contracts as |a|^n (max error {float(np.max(np.abs(s.perturbation_decay - s.predicted_decay))):.2e}).")
+    return s
