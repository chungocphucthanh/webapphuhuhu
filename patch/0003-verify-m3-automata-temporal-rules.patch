+"""Unit tests for Module 3 DFA verification, violation pinpointing, and ILP re-solve."""
+from __future__ import annotations
+from datetime import date, datetime, timedelta
+import pytest
+from streamlit.testing.v1 import AppTest
+from app.data_context import load_dataset_context
+from app.m3_section import (
+    check_m3_schedule, encode_daily_traces, evaluate_m3_traces, load_m3_automata, resolve_with_m3_rules,
+)
+from m2_ilp.config import TEAM_ID
+from m2_ilp.instance import Instance, toy_instance
+from m2_ilp.solve import solve
+from tools.make_seed import seed_for, soft_weights
+
+def _m3_subset_page():
+    from app.data_context import load_dataset_context
+    from app.m3_section import render_m3_section
+    render_m3_section(load_dataset_context("subset"))
+
+def _multi_day_instance(days_hours: list[tuple[int, int]], staff: int = 2) -> Instance:
+    starts = [datetime(2026, 5, d, h, 15 if h == 18 else 0) for d, h in days_hours]
+    return Instance(
+        seed=seed_for(TEAM_ID), availability="explicit", staff_ids=[f"CB{i + 1}" for i in range(staff)],
+        session_names=[f"S{j}" for j in range(len(starts))], demand=[1] * len(starts),
+        campus=["CS1"] * len(starts), day=[s.date() for s in starts],
+        intervals=[(s, s + timedelta(hours=2)) for s in starts], overlaps=[], baseline=[],
+        A={(i, j) for i in range(staff) for j in range(len(starts))},
+        preferences=["BAL"] * staff, soft_weights=soft_weights(TEAM_ID),
+    )
+
+def test_daily_trace_encoding_priority_and_gaps():
+    toy = toy_instance()
+    assert encode_daily_traces(toy, toy.baseline) == ((date(2026, 5, 18),), {"CB1": "A", "CB2": "A", "CB3": "M"})
+    inst = _multi_day_instance([(18, 7), (18, 13), (20, 18)], staff=2)
+    span, traces = encode_daily_traces(inst, [("CB1", "S0"), ("CB1", "S1"), ("CB1", "S2")])
+    assert len(span) == 3 and traces == {"CB1": "A-N", "CB2": "---"}
+
+def test_automata_json_and_clean_builder_fallback(tmp_path):
+    from_json, prod_json = load_m3_automata()
+    from_mem, prod_mem = load_m3_automata(tmp_path)
+    assert list(tmp_path.iterdir()) == [] and len(prod_json.states) == len(prod_mem.states) == 15
+    for word, expected in (("MA-N-", True), ("MM--MM-", True), ("MMM", False), ("NM", False), ("MM-MM-M", False)):
+        assert prod_json.accepts(word) is expected and prod_mem.accepts(word) is expected
+        assert all(m.accepts(word) == from_mem[k].accepts(word) for k, m in from_json.items())
+
+def test_exact_day_and_rule_violation_pinpointing():
+    dates = tuple(date(2026, 5, 18) + timedelta(days=k) for k in range(7))
+    res = evaluate_m3_traces({"S_OK": "MA-N--M", "S_R1": "MMM----", "S_R2": "-NA----", "S_R3": "MM-MM-M"}, dates=dates)
+    by_rule = {row["rule"]: row for row in res.rule_summaries}
+    assert not res.all_accepted and (by_rule["R1"]["accepted"], by_rule["R1xR2xR3"]["accepted"]) == (3, 1)
+    hits = {(v["invigilator_id"], v["rule"]): v for v in res.violations}
+    assert (hits["S_R1", "R1"]["day_step"], hits["S_R1", "R1"]["date"]) == (3, "2026-05-20")
+    assert (hits["S_R2", "R2"]["day_step"], hits["S_R2", "R2"]["symbol"]) == (3, "A")
+    assert (hits["S_R3", "R3"]["day_step"], hits["S_R3", "R3"]["date"]) == (7, "2026-05-24")
+
+def test_add_rules_to_m2_resolve_and_render():
+    toy_res = resolve_with_m3_rules(load_dataset_context("toy"), time_limit=10)
+    assert toy_res.all_accepted is True and toy_res.violations == () and toy_res.resolved_with_rules is True
+    one_staff = _multi_day_instance([(18, 18), (19, 7)], staff=1)
+    assert check_m3_schedule(one_staff, solve(one_staff).assigned).all_accepted is False
+    fixed = resolve_with_m3_rules(_multi_day_instance([(18, 18), (19, 7), (20, 7)], staff=2), time_limit=10)
+    assert fixed.all_accepted is True and fixed.violations == ()
+    at = AppTest.from_function(_m3_subset_page).run()
+    assert not at.exception and at.metric[0].value == "No"
+    at.checkbox(key="m3_enforce_rules").check().run()
+    assert not at.exception and at.metric[0].value == "Yes"
+
+def test_strict_validation_errors():
+    for bad in (lambda: evaluate_m3_traces({"CB1": "MX"}), lambda: check_m3_schedule(toy_instance(), [(99, 0)]),
+                lambda: check_m3_schedule(toy_instance(), [("UNKNOWN", "Morning")]),
+                lambda: check_m3_schedule(toy_instance(), [(1, 0), (1, 0)]),
+                lambda: resolve_with_m3_rules(toy_instance(), time_limit=0),
+                lambda: resolve_with_m3_rules(load_dataset_context("full"), time_limit=10)):
+        with pytest.raises(ValueError):
+            bad()
