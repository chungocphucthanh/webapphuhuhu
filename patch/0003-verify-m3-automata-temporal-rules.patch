+"""Module 3 automata verification, violation pinpointing, and rule-constrained re-solve."""
+from __future__ import annotations
+from dataclasses import dataclass, replace
+from datetime import date
+from pathlib import Path
+from typing import Iterable, Mapping, Sequence
+import pandas as pd
+import streamlit as st
+from app.data_context import DatasetContext, derive_model_config
+from m2_ilp.config import ModelConfig
+from m2_ilp.instance import Instance
+from m2_ilp.validate import check_schedule
+from m3_automata.dfa import DFA
+from m3_automata.product_min import M3_DIR, minimize, product
+from m3_automata.regular_to_ilp import calendar, live_states, roster_strings, solve_with_rules
+from m3_automata.rules import RULE_FILES, r1, r2, r3
+
+RULE_BUILDERS = {"R1": r1, "R2": r2, "R3": r3}
+RULE_DESCRIPTIONS = {
+    "R1": "At most 2 consecutive working days", "R2": "Rest day required after night shift",
+    "R3": "At most 4 working days in any 7-day window", "R1xR2xR3": "Minimal product DFA (R1 & R2 & R3)",
+}
+
+@dataclass(frozen=True)
+class M3CheckResult:
+    all_accepted: bool
+    rule_summaries: tuple[dict[str, object], ...]
+    invigilator_traces: tuple[dict[str, object], ...]
+    violations: tuple[dict[str, object], ...]
+    assignment: frozenset[tuple[int, int]] = frozenset()
+    resolved_with_rules: bool = False
+
+def load_m3_automata(m3_dir: Path | str | None = None) -> tuple[dict[str, DFA], DFA]:
+    """Load R1-R3 DFAs from JSON if present or in-memory builders, plus minimal product."""
+    root = Path(m3_dir) if m3_dir is not None else M3_DIR
+    individual = {n: DFA.load(root / RULE_FILES[n]) if (root / RULE_FILES[n]).is_file() else fn()
+                  for n, fn in RULE_BUILDERS.items()}
+    return individual, minimize(product(individual.values()))
+
+def _normalize_assignment(inst: Instance, assignment: object) -> frozenset[tuple[int, int]]:
+    if not isinstance(inst, Instance) or not inst.staff_ids or not inst.session_names:
+        raise ValueError("A valid non-empty Instance is required")
+    if assignment is None or isinstance(assignment, (str, bytes)) or not isinstance(assignment, Iterable):
+        raise ValueError("Assignment must be an iterable of (staff, session) pairs")
+    staff_map, sess_map = {s: i for i, s in enumerate(inst.staff_ids)}, {s: j for j, s in enumerate(inst.session_names)}
+    n, m, pairs = len(inst.staff_ids), len(inst.session_names), set()
+    for item in assignment:
+        if not isinstance(item, (tuple, list)) or len(item) != 2:
+            raise ValueError(f"Expected 2-element assignment pair, got {item!r}")
+        a, b = item
+        if type(a) is int and type(b) is int and 0 <= a < n and 0 <= b < m:
+            pair = (a, b)
+        elif isinstance(a, str) and isinstance(b, str) and a in staff_map and b in sess_map:
+            pair = (staff_map[a], sess_map[b])
+        else:
+            raise ValueError(f"Assignment pair out of range or unknown ID: {item!r}")
+        if pair in pairs:
+            raise ValueError(f"Duplicate assignment pair: {pair}")
+        pairs.add(pair)
+    return frozenset(pairs)
+
+def encode_daily_traces(inst: Instance, assignment: object) -> tuple[tuple[date, ...], dict[str, str]]:
+    """Reconstruct chronological {M, A, N, -} daily traces per invigilator."""
+    return tuple(calendar(inst)), roster_strings(inst, _normalize_assignment(inst, assignment))
+
+def locate_dfa_violation(dfa: DFA, word: str, dates: Sequence[date] | None = None) -> dict[str, object] | None:
+    """Return exact 1-based day step, date, symbol, and state of first rejection, or None."""
+    if not isinstance(word, str) or any(ch not in dfa.alphabet for ch in word):
+        raise ValueError(f"Trace contains symbols outside {tuple(dfa.alphabet)}: {word!r}")
+    if dates is not None and len(dates) != len(word):
+        raise ValueError("Dates length must match trace length")
+    dead, state = set(dfa.states) - live_states(dfa), dfa.start
+    for step, ch in enumerate(word, start=1):
+        state = dfa.transitions[state][ch]
+        if state in dead:
+            return {"day_step": step, "date": dates[step - 1].isoformat() if dates else f"Day {step}",
+                    "symbol": ch, "state": state, "prefix": word[:step]}
+    if state not in dfa.accepting:
+        step = len(word)
+        return {"day_step": step, "date": dates[-1].isoformat() if (dates and step) else f"Day {step}",
+                "symbol": word[-1] if step else "", "state": state, "prefix": word}
+    return None
+
+def evaluate_m3_traces(
+    traces: Mapping[str, str], *, dates: Sequence[date] | None = None, m3_dir: Path | str | None = None,
+    assignment: frozenset[tuple[int, int]] = frozenset(), resolved_with_rules: bool = False,
+) -> M3CheckResult:
+    """Evaluate invigilator traces against R1, R2, R3, and minimal product DFA."""
+    lengths = {len(w) for w in traces.values() if isinstance(w, str)} if traces else set()
+    if len(lengths) != 1 or any(not k or not isinstance(k, str) or not isinstance(w, str) for k, w in traces.items()):
+        raise ValueError("All invigilator IDs must be non-empty strings with equal-length traces")
+    rule_dfas, product_dfa = load_m3_automata(m3_dir)
+    machines, trace_rows, violation_rows = {**rule_dfas, "R1xR2xR3": product_dfa}, [], []
+    for inv_id, word in traces.items():
+        hits = {n: locate_dfa_violation(dfa, word, dates) for n, dfa in rule_dfas.items()}
+        violation_rows.extend({"invigilator_id": inv_id, "rule": n, **h} for n, h in hits.items() if h is not None)
+        prod_ok = product_dfa.accepts(word)
+        trace_rows.append({"invigilator_id": inv_id, "trace": word, "work_days": sum(c != "-" for c in word),
+                           **{n: h is None for n, h in hits.items()}, "product_accepted": prod_ok, "accepted": prod_ok})
+    total = len(trace_rows)
+    summaries = tuple({
+        "rule": n, "description": RULE_DESCRIPTIONS[n], "states": len(dfa.states),
+        "accepted": (acc := sum(bool(r["product_accepted" if n == "R1xR2xR3" else n]) for r in trace_rows)),
+        "rejected": total - acc, "total": total, "acceptance_rate": round(acc / total, 4),
+    } for n, dfa in machines.items())
+    return M3CheckResult(all(bool(r["product_accepted"]) for r in trace_rows), summaries,
+                         tuple(trace_rows), tuple(violation_rows), assignment, resolved_with_rules)
+
+@st.cache_data(show_spinner=False)
+def _cached_check_m3(inst: Instance, pairs: frozenset[tuple[int, int]], m3_dir_str: str | None) -> M3CheckResult:
+    dates, traces = encode_daily_traces(inst, pairs)
+    return evaluate_m3_traces(traces, dates=dates, m3_dir=m3_dir_str, assignment=pairs)
+
+def check_m3_schedule(inst: Instance, assignment: object, *, m3_dir: Path | str | None = None) -> M3CheckResult:
+    """Validate assignment and run cached M3 DFA evaluation."""
+    return _cached_check_m3(inst, _normalize_assignment(inst, assignment), str(m3_dir) if m3_dir else None)
+
+@st.cache_data(show_spinner=False)
+def _cached_resolve_m3(inst: Instance, cfg: ModelConfig, m3_dir_str: str | None) -> M3CheckResult:
+    sol, _, _ = solve_with_rules(inst, cfg, load_m3_automata(m3_dir_str)[1])
+    if sol.status not in ("optimal", "feasible") or check_schedule(inst, sol.assigned):
+        raise ValueError(f"M3-constrained ILP failed ({sol.status})")
+    dates, traces = encode_daily_traces(inst, sol.assigned)
+    return evaluate_m3_traces(traces, dates=dates, m3_dir=m3_dir_str, assignment=sol.assigned, resolved_with_rules=True)
+
+def resolve_with_m3_rules(
+    target: DatasetContext | Instance, *, time_limit: int = 15, m3_dir: Path | str | None = None,
+) -> M3CheckResult:
+    """Re-solve a live toy/subset slice with add_rules_to_m2 under a bounded time limit."""
+    if type(time_limit) is not int or not 1 <= time_limit <= 300:
+        raise ValueError("time_limit must be an integer between 1 and 300 seconds")
+    if isinstance(target, DatasetContext) and target.is_live_solvable:
+        inst, cfg = target.instance, replace(target.config, time_limit=time_limit)
+    elif isinstance(target, Instance) and len(target.session_names) <= 30:
+        inst, cfg = target, derive_model_config(target, time_limit=time_limit)
+    else:
+        raise ValueError("Live M3 ILP re-solve is restricted to toy/subset DatasetContext or small Instance")
+    return _cached_resolve_m3(inst, cfg, str(m3_dir) if m3_dir else None)
+
+def render_m3_section(
+    ctx: DatasetContext, assignment: object = None, *, time_limit: int | None = None, enforce_rules: bool = False,
+) -> M3CheckResult:
+    """Render M3 DFA acceptance banner, rule summary, trace table, and violation locator."""
+    st.subheader("M3. Automata, Temporal Shift Rules & DFA Verification")
+    raw = assignment.assignment if hasattr(assignment, "assignment") else (ctx.instance.baseline if assignment is None else assignment)
+    use_rules = st.checkbox("Re-solve slice with M3 DFA flow constraints (add_rules_to_m2)",
+                            value=enforce_rules, key="m3_enforce_rules") if ctx.is_live_solvable else False
+    result = (resolve_with_m3_rules(ctx, time_limit=ctx.config.time_limit if time_limit is None else time_limit)
+              if use_rules else check_m3_schedule(ctx.instance, raw))
+    prod_row = result.rule_summaries[-1]
+    for col, (lbl, val) in zip(st.columns(4), (
+        ("Schedule valid (DFA-accepted)", "Yes" if result.all_accepted else "No"),
+        ("DFA-Accepted Staff", f"{prod_row['accepted']}/{prod_row['total']}"),
+        ("Rule Violations", str(len(result.violations))),
+        ("Minimal Product States", str(prod_row["states"])),
+    )):
+        col.metric(lbl, val)
+    (st.success if result.all_accepted else st.warning)(
+        f"Schedule valid (DFA-accepted): {result.all_accepted} — {len(result.violations)} rule violation(s) across {prod_row['total']} traces."
+    )
+    st.dataframe(pd.DataFrame(result.rule_summaries), use_container_width=True, hide_index=True)
+    only_bad = st.checkbox("Show only rejected invigilator traces", value=False, key="m3_only_rejected")
+    shown = [r for r in result.invigilator_traces if not r["accepted"]] if only_bad else list(result.invigilator_traces)
+    st.dataframe(pd.DataFrame(shown), use_container_width=True, hide_index=True)
+    if result.violations:
+        st.caption("Exact Day/Step & Rule Violation Locator")
+        st.dataframe(pd.DataFrame(result.violations), use_container_width=True, hide_index=True)
+    return result
